<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="工友打卡系统 V4"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="请选择模式"
            android:textSize="16sp"
            android:gravity="center"
            android:paddingBottom="18dp"/>

        <Button
            android:id="@+id/btnForeman"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="工头：扫描员工 QR"
            android:textSize="18sp"/>

        <Button
            android:id="@+id/btnEmployee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="员工：显示我的 QR"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="查看今天打卡记录 / 工资"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <ImageView
            android:id="@+id/ivQr"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            android:contentDescription="员工二维码"/>

        <TextView
            android:id="@+id/tvEmployee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="17sp"
            android:gravity="center"
            android:padding="10dp"/>

    </LinearLayout>
</ScrollView>
